{
  "entities": {
    "charterInquiry": {
      "title": "Charter Inquiry",
      "description": "Private jet flight charter inquiry submitted by a client",
      "type": "object",
      "properties": {
        "tripType": {
          "type": "string",
          "enum": ["one-way", "round-trip"],
          "description": "Whether the journey is one-way or round-trip"
        },
        "departureAirport": {
          "type": "string",
          "description": "Departure airport or FBO"
        },
        "arrivalAirport": {
          "type": "string",
          "description": "Arrival airstrip or airport"
        },
        "flightDate": {
          "type": "string",
          "description": "Date of flight departure"
        },
        "passengers": {
          "type": "number",
          "description": "Number of passengers travelling"
        },
        "jetTier": {
          "type": "string",
          "description": "Requested aircraft class"
        },
        "contactName": {
          "type": "string",
          "description": "Name of primary passenger or booker"
        },
        "contactEmail": {
          "type": "string",
          "format": "email",
          "description": "Contact email address"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when inquiry was submitted"
        }
      },
      "required": [
        "tripType",
        "departureAirport",
        "arrivalAirport",
        "flightDate",
        "passengers",
        "jetTier",
        "contactName",
        "contactEmail",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/charterInquiries/{inquiryId}": {
      "schema": "charterInquiry",
      "description": "Collection of private flight charter inquiries submitted by users"
    }
  }
}
